@model List<EcommerceApp.Product>

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nishma's Ecommerce </title>

    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                padding: 40px 20px;
                font-family: Arial, sans-serif;
                background: #f1f5f9;
                color: #1e293b;
            }

            .container {
                max-width: 1000px;
                margin: auto;
            }

            .header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 25px;
                margin-bottom: 25px;
                background: linear-gradient(135deg, #2e1065, #6d28d9);
                border-radius: 15px;
                color: white;
            }

                .header h1 {
                    margin: 0;
                }

                .header p {
                    margin: 5px 0 0;
                    opacity: .8;
                }

            a, button {
                border: 0;
                border-radius: 8px;
                padding: 9px 14px;
                text-decoration: none;
                cursor: pointer;
                font-weight: bold;
            }

            .add-btn {
                background: white;
                color: #4f46e5;
            }

            .products {
                display: grid;
                gap: 12px;
            }

            .product {
                display: grid;
                grid-template-columns: 1fr 150px 180px;
                align-items: center;
                padding: 18px 20px;
                background: white;
                border-radius: 12px;
                box-shadow: 0 3px 12px #00000010;
            }

            .product-name {
                font-weight: bold;
            }

            .price {
                color: #16a34a;
                font-weight: bold;
            }

            .actions {
                display: flex;
                gap: 8px;
                justify-content: flex-end;
            }

            .edit {
                background: #3b82f6;
                color: white;
            }

            .delete {
                background: #ef4444;
                color: white;
            }

            .empty {
                padding: 50px;
                text-align: center;
                background: white;
                border-radius: 12px;
            }

            @@media (max-width: 700px) {
                .header {
                    flex-direction: column;
                    align-items: stretch;
                    gap: 15px;
                }

                .add-btn {
                    text-align: center;
                }

                .product {
                    grid-template-columns: 1fr;
                    gap: 10px;
                }

                .actions {
                    justify-content: flex-start;
                }
            }
    </style>
</head>

<body>

    <div class="container">

        <div class="header">
            <div>
                <h1 style="align-content:center">Nishma's Ecommerce</h1>
                <p>Manage your products easily</p>
            </div>

            <a href="/product/add" class="add-btn">
                + Add Product
            </a>
        </div>

        @if (Model == null || Model.Count == 0)
        {
            <div class="empty">
                <h3>📦 No products available</h3>
                <p>Start by adding your first product.</p>
            </div>
        }
        else
        {
            <div class="products">

                @foreach (var product in Model)
                {
                    <div class="product">

                        <div class="product-name">
                            @product.Name
                        </div>

                        <div class="price">
                            $@product.Price
                        </div>

                        <div class="actions">

                            <a href="/product/edit/@product.Id"
                               class="edit">
                                ✏ Edit
                            </a>

                            <form method="post"
                                  action="/product/delete/@product.Id"
                                  style="display:inline;">

                                <button type="submit" class="delete">
                                    🗑 Delete
                                </button>

                            </form>

                        </div>

                    </div>
                }

            </div>
        }

    </div>

</body>
</html>
